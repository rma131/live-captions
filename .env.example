# Copy to .env and fill in. .env is gitignored — never commit keys.

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Device is matched by NAME SUBSTRING, never by index. Indices move between
# reboots, when a projector is plugged in, and — observed on Linux — between two
# runs in the same session.
#
# On Linux the MixPre is reached through PipeWire's "pro-audio" node, NOT the raw
# hw: device. WirePlumber holds the ALSA PCM open, so hw:0,0 is unavailable to us
# and "MixPre-10T:" matches nothing. Use the Pro node: 16 channels at 48 kHz,
# passed through 1:1, mics on 1/2/3. Confirmed working end to end.
#
# Do NOT try to take the card away from PipeWire. Holding the stream open is
# load-bearing: the MixPre detaches from USB the moment internal recording starts
# if the host is not actively streaming. See 01_Projects/20260909_MixPre10Tusb.
#
# Before an event:
#   mixpre-session status      # graph must read 48000 Hz, allowed rates [ 48000 ]
#   mixpre-session lock        # a host rate change REBOOTS the MixPre mid-take
AUDIO_DEVICE_MATCH=MixPre-10T Pro

# ---------------------------------------------------------------- mode (spec 006)
# mics   = the wedding: one microphone per language, fixed languages, energy gate.
# single = one microphone, one speaker switching between exactly two LANGS,
#          detected continuously. Operator keys: 1 / 2 force a language,
#          0 back to automatic, W flags the last caption as wrong.
MODE=mics
# For Montréal, the Canadian models are worth trying first: in testing, forcing
# fr-CA kept an English sentence intelligible where fr-FR garbled it. Measured
# on synthetic voices only — confirm on real speech before relying on it.
LANGS=en-CA,fr-CA

# Record the captured audio for later replay. ONLY with the speaker's consent.
RECORD_AUDIO=0

# Show web/fc-*.svg artwork on the mute screen. Off unless this event's own
# artwork is in place: another event's artwork must never reach a screen.
MUTE_LOGO=0

# Channel -> fixed source language. No detection, ever.
# Mic 1 = button 1 = leftmost pane, and so on.
CH1_LANG=es-ES
CH2_LANG=en-US
CH3_LANG=tr-TR

# Which USB channel each mic ACTUALLY arrives on, 1-based, as shown by
# scripts/meters.py.
#
# VERIFIED on the MixPre 2026-09-09 with three SM58s: speaking close into one mic
# puts it 18-35 dB above the other two, and the gate picks it correctly.
# Isolated inputs map straight through, input N -> USB N, with the stereo mix
# last on USB 11-12 — the opposite of the L-8, where the mix was on 1-2.
#
# Re-check at every venue anyway. Getting this wrong fails silently: a channel
# carrying the mix sums every microphone, so it always wins the gate and the
# whole room is attributed to one language, with captions that look plausible.
CH1_USB=1
CH2_USB=2
CH3_USB=3

# Energy gate. Tune this at the venue with all three mics open and room noise.
# RMS on float32 audio in 0.0-1.0.
#
# Measured on the MixPre with SM58s, 2026-09-09:
#   room tone, nobody speaking     0.001 - 0.002
#   speaking close into one mic    0.015 - 0.215
#   that mic's bleed into the rest 0.002 - 0.008
# 0.010 sits in the gap and worked. Lower it with [ if a speaker stands off-mic;
# a quiet talker measured 0.009 and was dropped.
GATE_THRESHOLD=0.010


# Turkish puts the verb (and negation) at the end, so a partial Turkish sentence
# can translate to the OPPOSITE of the finished one. Translating any partial also
# forces word-order guesses that then get rewritten on screen.
# off = only the column of the language being SPOKEN updates live; the two
#       translation columns settle once, when the sentence is complete.
# on  = translate partial sentences too (faster, but the text churns).
INTERIM_TRANSLATIONS=off

# Prepared, human-translated lines in glossary/speeches.yaml. A finished sentence
# this similar to a prepared line shows YOUR translation instead of the machine's.
# Lower = matches more loosely (risks wrong substitutions). 0 disables entirely.
SCRIPT_MATCH=0.78

# Reconnect backoff after a dropped uplink, per session, in seconds.
RETRY_BASE_S=1.0
RETRY_MAX_S=20.0

# Every finalised line is appended here as JSONL for review afterwards.
# Gitignored — it will contain the actual speeches.
TRANSCRIPT_DIR=transcripts

# Notion, for authoring the speeches. Used ONLY by scripts/import_speeches.py,
# never by the live system — captions.py reads glossary/speeches.yaml and makes
# no Notion call at all. Leave blank to use the CSV export path instead.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03

# Guest phones. 127.0.0.1 keeps everything on this laptop; 0.0.0.0 also serves
# /guest to the venue network. Controls stay loopback-only either way.
BIND_HOST=127.0.0.1

# Display
# Display theme at startup: dark (default) or light for a bright room.
# L on the page toggles it live and remembers the choice on that screen.
THEME=dark
FONT_SIZE=48
